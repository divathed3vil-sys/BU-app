<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- BU is dark by doctrine. windowBackground = Bg0 kills the white cold-start flash. -->
    <style name="Theme.BU" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bu_bg0</item>
        <item name="android:statusBarColor">@color/bu_bg0</item>
        <item name="android:navigationBarColor">@color/bu_bg0</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
