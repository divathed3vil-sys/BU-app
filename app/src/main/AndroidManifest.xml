<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Care round-trip: notifications are the delivery half of a reminder. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms only where the OS grants them; inexact is always described
         as inexact in the UI (locked plan §10). Never a silent lie. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Persisted schedules: BU re-arms its alarm projection after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".BUApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BU">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BU">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A care alarm ringing: the platform reports; the ledger decides. -->
        <receiver
            android:name=".platform.CareReceiver"
            android:exported="false" />

        <!-- Boot re-arm: alarms never survive a reboot; the projection is
             rebuilt from SQLite, which does (locked plan §10). -->
        <receiver
            android:name=".platform.BuBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The NOW widget: today at a glance, rebuilt from the ledger. -->
        <receiver
            android:name=".platform.BuWidgetProvider"
            android:exported="false"
            android:label="BU · NOW">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bu_widget_info" />
        </receiver>
    </application>

</manifest>
